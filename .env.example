# Copy to .env — never commit secrets.

PORT=5190

# --- Buyer agent (ERC-8004 · Ethereum Sepolia) ---
BUYER_AGENT_ID=9638
BUYER_AGENT_NAME=craidt-buyer-agent
BUYER_CHAIN_ID=11155111
BUYER_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
BUYER_WALLET_ADDRESS=
# Optional private key for feedback / signing demos
BUYER_WALLET_PRIVATE_KEY=

# --- Seller / Shopify platform agent (ERC-8004 · Base Sepolia) ---
# Default: working Base Sepolia registration used in prior demos.
SELLER_AGENT_ID=6832
SELLER_AGENT_NAME=shopify-commerce-agent
SELLER_CHAIN_ID=84532
SELLER_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
SELLER_PAYTO_ADDRESS=
SELLER_SERVICE_URL=

# --- Chains / RPC ---
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://sepolia.base.org
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EXPLORER_BASE_URL=https://sepolia.basescan.org
EXPLORER_SEPOLIA_URL=https://sepolia.etherscan.io

# --- x402 (Base Sepolia) ---
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- 8004scan ---
SCAN8004_API_BASE=https://testnet.8004scan.io/api/v1
SCAN8004_WEB_BASE=https://testnet.8004scan.io
SCAN8004_API_KEY=

# --- ENSv2 (ETHOnline Sepolia hackathon deployment ONLY) ---
# Source of truth: https://feature-permres-inode-refact.docs-bao.pages.dev/learn/deployments#sepolia-ensv2-beta
# Do NOT use production docs addresses. Override viem Universal Resolver with ENS_UNIVERSAL_RESOLVER_PROXY.
ENS_CHAIN_ID=11155111
ENS_RPC=$SEPOLIA_RPC
ENS_ETH_REGISTRY=0x1d78834d97c1d7b1a38c1dedbd1a287cfed3971e
ENS_ETH_REGISTRAR=0x7d1b7f586a62ac3f54b9a396849757814283270b
ENS_ROOT_REGISTRY=0xe7f0d5724f8337e3aa9a9910540341ff4273fed9
ENS_VERIFIABLE_FACTORY=0x894bc9cc8ff1ad96b8a288c86a8c71d662c07780
ENS_USER_REGISTRY_IMPL=0x47b442d0cf617c41cabaff5f02f44dd1e5f72546
ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
ENS_UNIVERSAL_RESOLVER_V2=0xfea8d4b7fcce0b8765c793d6695eac384aaa458f
ENS_UNIVERSAL_RESOLVER_PROXY=0xd26f2040d083af1cd2962ba303f4bea0c4faf142
# Deployer that owns the Shopify head registry / subregistry
ENS_DEPLOYER_PRIVATE_KEY=
# Root label under .eth for this demo (e.g. shopify → shopify.eth)
ENS_ROOT_LABEL=shopify
# Demo mode: lazily register merchant subnames on first UCP hit
ENS_LAZY_CREATE=true
# dry-run = resolve/slug only; live = send Sepolia txs
ENS_WRITE_MODE=dry-run

# --- OpenAI (buyer intent clarification) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Commerce wallets (Sepolia MockUSDC settlement) ---
BUYER_WALLET_ADDRESS=0xCD643061B9a5D96AD8595B252fE098EA33a39D91
BUYER_WALLET_PRIVATE_KEY=
SHOPIFY_WALLET_ADDRESS=0x3187c1BE84d919Ad603CDfcAac392e586B50bf68
